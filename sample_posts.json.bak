        "post_author": "user_78",
        "created_at": "2024-06-11T20:42:10.832272+00:00",
        "modified_at": "2024-06-11T20:42:10.832272+00:00",
        "post_text": "Just booked tickets to Kennedy Space Center. Been a lifelong dream to watch a launch in person. Couldn't be more excited. \ud83d\ude80 #KSC #NASAFan",
        "likes": 349,
        "image_url": null
    },
