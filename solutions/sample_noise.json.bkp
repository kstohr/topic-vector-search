        "post_author": "user_31",
        "created_at": "2026-03-15T08:47:45.774631Z",
        "modified_at": "2026-04-25T02:24:53.993186Z",
        "post_text": "Ensuring efficient land use: The High Speed Rail infrastructure across Fresno has already provided better public parks.",
        "likes": 0,
        "image_url": null,
        "generated_topic": "California High Speed Rail"
    },
    {
